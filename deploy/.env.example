# Câmera Intelbras VIP 3230 B. A senha precisa ser codificada na URL:
# @ vira %40 e ! vira %21.
CAMERA_ID=cam1
RTSP_URL=rtsp://admin:SENHA_CODIFICADA@192.168.0.8:554/cam/realmonitor?channel=1&subtype=0

# Onde gravar, no servidor.
# Onde as gravações ficam. Precisa existir antes de subir: se apontar para
# pasta inexistente, o Docker a cria vazia e o sistema passa a ler dali sem
# reclamar — o painel diz zero gravações com o disco cheio delas.
RECORDINGS_PATH=/srv/argos

# Segmentos de 10 minutos: arquivo pequeno o bastante para copiar e grande o
# bastante para não encher o diretório de milhares de arquivos.
SEGMENT_SECONDS=600

# Retenção. Com 1080p a 4 Mbps são ~43 GB/dia; 700 GB dão cerca de 16 dias.
MAX_GB=700
MAX_DAYS=30
MIN_FREE_GB=20
CHECK_MINUTES=10
